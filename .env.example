# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres, POOLED connection string (hostname contains -pooler)
DATABASE_URL=

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Newest stable Flash available to the key on 2026-09-18 (verified with a real call)
GEMINI_MODEL=gemini-3.8-flash

# Groq: https://console.groq.com/keys (Whisper transcription)
GROQ_API_KEY=

# OpenRouter: https://openrouter.ai/keys (LLM fallback, free models only)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=deepseek/deepseek-v4-flash-0731:free,nvidia/nemotron-3-super-120b-a12b:free

# Vercel Blob. Created by Vercel when the Blob store is attached (step 1)
BLOB_READ_WRITE_TOKEN=

# Signs the demo session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
