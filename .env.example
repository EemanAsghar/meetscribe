# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres, POOLED connection string (hostname contains -pooler)
DATABASE_URL=

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Primary model, then siblings tried in order. Every Flash model has its own 20 requests/day free bucket. 3.8 was the newest on 2026-09-18 but hung
# all day on the free tier, so 3.6 leads and 3.8 stays in the chain in case it recovers.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash

# Groq: https://console.groq.com/keys. Whisper transcription, and a fast chat fallback (1,000 requests/day,
# 8,000 tokens/minute). Leads only for small prompts; see the header of src/lib/llm.ts.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# OpenRouter: https://openrouter.ai/keys (LLM fallback, free models only)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=deepseek/deepseek-v4-flash-0731:free,nvidia/nemotron-3-super-120b-a12b:free

# Vercel Blob. Created by Vercel when the Blob store is attached (step 1)
BLOB_READ_WRITE_TOKEN=

# Signs the demo session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
